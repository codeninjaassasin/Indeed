# Copy to .env and fill in. .env is gitignored — never commit real values.

# Mattermost incoming webhook. New jobs are posted here as "Indeed New Jobs".
MATTERMOST_WEBHOOK_URL=

# Optional. Only needed when the Mattermost host uses an internal/private CA
# (e.g. Caddy's local authority) that Python's certifi bundle does not carry.
# Path to a PEM bundle; relative paths resolve against the project directory.
# See README "Internal CA" for how to generate one.
MATTERMOST_CA_BUNDLE=
